VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" (in .env.local) to route the photo-to-price callable to a
# local emulator (firebase emulators:start --only functions). All other
# Firebase services keep talking to production.
VITE_FIREBASE_FUNCTIONS_EMULATOR=
