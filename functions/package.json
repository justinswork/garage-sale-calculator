{
  "name": "garage-sale-calculator-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/copy-prompts.mjs && tsc && node scripts/copy-corpus.mjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "corpus:build": "node --env-file=.secret.local scripts/build-corpus.mjs",
    "corpus:build:dry": "node --env-file=.secret.local scripts/build-corpus.mjs --dry-run",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "voyageai": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5"
  }
}
