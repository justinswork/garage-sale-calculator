rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Billing-protected fields. Only the Stripe webhook (running with the
    // admin SDK, which bypasses these rules) is allowed to touch these.
    // Without this gate a savvy user could flip purchased=true on their
    // own event and skip the $5 charge.
    function isWritingPurchaseFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['purchased', 'purchasedAt', 'purchasedByUid', 'stripeCheckoutSessionId']);
    }

    match /events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'createdAt', 'createdByUid', 'status'])
        // New events can't claim to already be paid-for.
        && !('purchased' in request.resource.data);
      allow read: if signedIn();
      allow update: if signedIn() && !isWritingPurchaseFields();
      // Only the original creator can hard-delete the event (and the
      // creator-only audit cleanup below mirrors that gate).
      allow delete: if signedIn() && resource.data.createdByUid == request.auth.uid;

      match /hosts/{hostId} {
        allow read, write: if signedIn();
      }

      match /sales/{saleId} {
        allow read, write: if signedIn();
      }

      match /quickAddItems/{itemId} {
        allow read, write: if signedIn();
      }

      match /audit/{logId} {
        allow read, create: if signedIn();
        allow update: if false;
        // Audit is immutable except when the event creator is tearing the
        // whole event down — at that point the audit history is meaningless.
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/events/$(eventId)).data.createdByUid == request.auth.uid;
      }

      match /settlements/{settlementId} {
        allow read, write: if signedIn();
      }
    }

    // App-wide config (e.g. /config/promo). Read-only to clients so the
    // UI can react in real time to admin-driven promo windows. All writes
    // happen through the Firebase Console with the admin's account, which
    // bypasses these rules.
    match /config/{configId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
